# ==============================================================================
# StudentAI — AI-Powered Academic Performance Intelligence
# Environment Configuration Template (.env.example)
# Copy this file to .env and fill in your actual credentials.
# NEVER commit your actual .env file to version control.
# ==============================================================================

# 1. Supabase PostgreSQL Configuration (Primary Persistent Database & Auth)
SUPABASE_URL=YOUR_SUPABASE_URL
SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY

# 2. Generative AI Provider Keys (Configure at least one provider)
OPENAI_API_KEY=YOUR_KEY
GEMINI_API_KEY=YOUR_KEY
OPENROUTER_API_KEY=YOUR_KEY
OPENROUTER_MODEL=openai/gpt-4o-mini

# 3. Optional Application Settings
DEFAULT_AI_PROVIDER=gemini
FALLBACK_AI_PROVIDER=openrouter
OPENAI_MODEL=gpt-4o-mini
GEMINI_MODEL=gemini-2.5-flash
